# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Google Maps (Google Cloud project: patna-rent-map-512807) ---
# Maps JavaScript API key. Restrict it to your site's HTTP referrers in Cloud Console.
VITE_GOOGLE_MAPS_KEY=
# Cloud Map ID with a DARK map style (needed for Advanced Markers).
VITE_GOOGLE_MAP_ID=

# --- Firebase (Firebase project: patna-rent-map) ---
# From Firebase console > Project settings > Your apps > SDK setup (config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
